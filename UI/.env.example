# =============================================================================
# UI (:7860) — Gradio. Copy to .env in this folder for a standalone git.
# In the monorepo, root .env fills keys this file does not set.
#
#   cp .env.example .env
#   python -m ui_app.ui.gradio_app
#
# No LLM keys, no SQLite, no Azure SQL, no Blob. HTTP client → ip_api only.
# Switch local vs Azure from the Gradio **API targets** tab (JSON).
# Example: UI/config/ui_targets.example.json  Runtime (gitignored): UI/config/ui_runtime.json
# Azure Web App example JSON: UI/config/azure-webapp.settings.json
# =============================================================================

# DEBUG_FLOW=1
API_BASE_URL=http://127.0.0.1:8000
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
# Optional fallback if admin_api_key is empty in ui_runtime.json (must match API ADMIN_API_KEY)
# ADMIN_API_KEY=
