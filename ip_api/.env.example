# =============================================================================
# ip_api (:8000) — FastAPI gateway. Copy to .env in this folder (standalone git).
# In the monorepo, root .env fills keys this file does not set.
#
#   cp .env.example .env
#   python -m ip_api.run_app --api-only
# =============================================================================

# --- Bind ---
# DEBUG_FLOW=1
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=25
JOB_TTL_HOURS=24

# --- Downstream (required when this folder is run alone) ---
# API → MAF (no /invoke suffix). CENTRAL_AGENT_END_POINT wins; MAF_BASE_URL / MAF_URL are aliases.
CENTRAL_AGENT_END_POINT=http://127.0.0.1:8003
MAF_BASE_URL=http://127.0.0.1:8003
# MAF_URL=http://127.0.0.1:8003
# MAF_PROXY_TIMEOUT=320
DOCUMENT_MCP_URL=http://127.0.0.1:8001/mcp
VOICE_MCP_URL=http://127.0.0.1:8002/mcp

# --- Health banner only (pipeline LLMs run in document MCP) ---
MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
MAPPER_MODEL=gpt-5-mini
VALIDATOR_MODEL_ID=openai:gpt-4.1-mini
VALIDATOR_PROVIDER=openai
VALIDATOR_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# GROQ_API_KEY=

# Judge retry / accuracy bar (omit form fields on POST /documents/jobs to use these)
DOCUMENT_MAX_RETRIES=1
DOCUMENT_VALIDATION_THRESHOLD=0.7

# Optional mapper optimisation (off by default)
# DOCUMENT_LLM_OPTIMIZATION_ENABLED=false

# --- Speech (POST /audio/transcribe) — billed per minute, not tokens ---
SPEECH_PROVIDER=groq
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_WHISPER_MODEL=whisper-1
# SPEECH_PROVIDER=openai
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# =============================================================================
# STORAGE — SQLite (local)  |  Azure SQL + Blob (cloud)  — env only, no code change
# Unset SQLALCHEMY_DATABASE_URL, AZURE_SQL_SERVER, AZURE_SQL_PASSWORD,
# AZURE_KEY_VAULT_NAME, AZURE_KEY_VAULT_URL  → SQLite at SQLITE_DATABASE_PATH
# Unset AZURE_STORAGE_* and keep FILE_STORAGE_BACKEND=local  → local files
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
TEMPLATES_SUBDIRECTORY=templates
FILE_STORAGE_BACKEND=local

# --- Azure SQL (commented = SQLite). Also comment vault name or the launcher
#     will fetch AZURE_SQL_PASSWORD when SERVER is still set. ---
# AZURE_SQL_SERVER=YOUR_SQL.database.windows.net
# AZURE_SQL_USER=adminsql
# AZURE_SQL_DATABASE=ipp-app-db
# AZURE_SQL_DIALECT=pyodbc
# AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQLALCHEMY_DATABASE_URL=
# AZURE_KEY_VAULT_NAME=YOUR-VAULT
# AZURE_SQL_PASSWORD_SECRET_NAME=azure-sql-password
# AZURE_SQL_PASSWORD=

# --- Cloud: Azure Blob ---
# FILE_STORAGE_BACKEND=azure_blob
# AZURE_BLOB_CONTAINER=docuploadsolution
# AZURE_BLOB_PREFIX=jobs
# AZURE_BLOB_TEMPLATE_PREFIX=templates
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_SAS_TOKEN=
# AZURE_STORAGE_SAS_URL=

# --- Admin template library (POST /api/v1/admin/templates) ---
# X-Admin-Api-Key. Unset disables the admin routes.
ADMIN_API_KEY=

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
