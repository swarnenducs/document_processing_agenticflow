# =============================================================================
# central-agentic-flow MAF (:8003) — copy to .env in this folder (standalone git).
# In the monorepo, root .env fills keys this file does not set.
#
#   cp .env.example .env
#   python -m central_agentic_flow.server
#
# MCP URLs are also listed in config/mcp_registry.yml — env overrides YAML.
# =============================================================================

# --- Bind ---
# DEBUG_FLOW=1
MAF_HOST=0.0.0.0
MAF_PORT=8003
# MAF_MCP_TIMEOUT_SECONDS=300

# --- Orchestrator LLM (chat /ask only; jobs use POST /invoke, no chat model) ---
MAF_MODEL_ID=openai:gpt-5-mini
MAF_PROVIDER=openai
MAF_MODEL=gpt-5-mini
# MAF_API_KEY=
# MAF_LLM_BASE_URL=
# MAF_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# GROQ_API_KEY=

# --- Prompts / registry ---
# MAF_PROMPTS_DIR=./prompts
# MAF_INSTRUCTIONS_FILE=./prompts/orchestrator_instructions.md
# MAF_INSTRUCTIONS=
# MAF_MCP_REGISTRY_FILE=./config/mcp_registry.yml

# --- Downstream MCP HTTP (required when this folder is run alone) ---
DOCUMENT_MCP_URL=http://127.0.0.1:8001/mcp
VOICE_MCP_URL=http://127.0.0.1:8002/mcp
# BUSINESS_MCP_URL=http://127.0.0.1:8005/mcp
# MAF_EXTRA_MCPS=fabric=http://127.0.0.1:8004/mcp
# MAF_MCP_FABRIC_DESCRIPTION=Fabric SQL agent
# MAF_MCP_SERVERS=[{"name":"fabric-sql-agent","url":"http://127.0.0.1:8004/mcp","prefix":"fabric"}]

# --- Microsoft Foundry hosted chat agent (foundry_main.py) ---
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# TOOLBOX_ENDPOINT=https://YOUR-TOOLBOX-ENDPOINT/mcp?api-version=v1
# FOUNDRY_MAF_INSTRUCTIONS=

# =============================================================================
# STORAGE — SQLite (local)  |  Azure SQL (cloud)  — call_logs / traces only
# Unset AZURE_SQL_*  → SQLite at SQLITE_DATABASE_PATH
# Set AZURE_SQL_*    → Azure SQL
# =============================================================================
TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
# AZURE_SQL_SERVER=YOUR_SQL.database.windows.net
# AZURE_SQL_USER=adminsql
# AZURE_SQL_DATABASE=ipp-app-db
# AZURE_SQL_DIALECT=pyodbc
# AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQLALCHEMY_DATABASE_URL=
# AZURE_KEY_VAULT_NAME=YOUR-VAULT
# AZURE_SQL_PASSWORD_SECRET_NAME=azure-sql-password
# AZURE_SQL_PASSWORD=
