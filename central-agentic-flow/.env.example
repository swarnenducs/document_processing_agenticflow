# central-agentic-flow (MAF) — copy to .env in this folder (standalone git).
# In the monorepo, a root .env is also loaded (this file wins if both set a key).
#
#   cp .env.example .env
#   python -m central_agentic_flow.server
#
# MCP URLs are also listed in config/mcp_registry.yml — env overrides YAML.

# --- Bind ---
MAF_HOST=0.0.0.0
MAF_PORT=8003
# MAF_MCP_TIMEOUT_SECONDS=300

# --- Orchestrator LLM ---
MAF_MODEL_ID=openai:gpt-5-mini
MAF_PROVIDER=openai
MAF_MODEL=gpt-5-mini
# MAF_API_KEY=
# MAF_LLM_BASE_URL=
# MAF_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# GROQ_API_KEY=

# --- Prompts / registry (defaults: ./prompts and ./config/mcp_registry.yml) ---
# MAF_PROMPTS_DIR=./prompts
# MAF_INSTRUCTIONS_FILE=./prompts/orchestrator_instructions.md
# MAF_INSTRUCTIONS=
# MAF_MCP_REGISTRY_FILE=./config/mcp_registry.yml

# --- Downstream MCP HTTP endpoints (required when split) ---
# Jobs only: reachable from POST /invoke, never from chat.
DOCUMENT_MCP_URL=http://127.0.0.1:8001/mcp
VOICE_MCP_URL=http://127.0.0.1:8002/mcp
# Chat only: the business MCP behind /ask and the Foundry agent.
# Unset means chat answers without tools.
# BUSINESS_MCP_URL=http://127.0.0.1:8005/mcp
# Extra servers without editing YAML:
# MAF_EXTRA_MCPS=fabric=http://127.0.0.1:8004/mcp
# MAF_MCP_FABRIC_DESCRIPTION=Fabric SQL agent
# MAF_MCP_SERVERS=[{"name":"fabric-sql-agent","url":"http://127.0.0.1:8004/mcp","prefix":"fabric"}]

# --- Microsoft Foundry hosted chat agent (foundry_main.py) ---
# The project endpoint is injected after provisioning; set it for local runs.
# FOUNDRY_PROJECT_ENDPOINT=https://YOUR-ACCOUNT.services.ai.azure.com/api/projects/YOUR-PROJECT
# AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
# Optional: business Toolbox. Unset means the hosted agent answers without tools.
# TOOLBOX_ENDPOINT=https://YOUR-TOOLBOX-ENDPOINT/mcp?api-version=v1
# FOUNDRY_MAF_INSTRUCTIONS=

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
