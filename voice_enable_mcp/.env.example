# =============================================================================
# voice_enable_mcp (:8002) — voice → contract HITL. Copy to .env in this folder.
# In the monorepo, root .env fills keys this file does not set.
#
#   cp .env.example .env
#   python -m voice_enable_mcp.server
# =============================================================================

# --- Bind ---
VOICE_MCP_HOST=127.0.0.1
VOICE_MCP_PORT=8002
VOICE_MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8002
# VOICE_PROMPTS_DIR=./prompts

# --- Speech-to-text (when audio is passed to this MCP) ---
SPEECH_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_WHISPER_MODEL=whisper-1
# SPEECH_PROVIDER=openai
# OPENAI_API_KEY=
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# --- Contract agent LLM ---
# AGENT_MODEL_ID=openai:gpt-5-mini
MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# =============================================================================
# STORAGE — SQLite (local)  |  Azure SQL (cloud)
# Unset AZURE_SQL_*  → SQLite at SQLITE_DATABASE_PATH
# Set AZURE_SQL_*    → Azure SQL (voice_contracts, call_logs, HITL tables)
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
AUDIO_SUBDIRECTORY=audio
MAX_UPLOAD_MB=25

# --- Cloud: Azure SQL ---
# AZURE_SQL_SERVER=YOUR_SQL.database.windows.net
# AZURE_SQL_USER=adminsql
# AZURE_SQL_PASSWORD=
# AZURE_SQL_DATABASE=ipp-app-db
# AZURE_SQL_DIALECT=pyodbc
# AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQLALCHEMY_DATABASE_URL=

# =============================================================================
# HITL CHECKPOINTER — sql (default, same SQLite / Azure SQL)  |  redis
# Contracts still go to SQL either way. Only interrupt/resume thread_id moves.
# =============================================================================
LANGGRAPH_CHECKPOINT_BACKEND=sql
# LANGGRAPH_CHECKPOINT_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
# LANGGRAPH_CHECKPOINT_REDIS_PREFIX=lg
# LANGGRAPH_CHECKPOINT_REDIS_TTL_SECONDS=86400

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
