# voice_enable_mcp — copy to .env in this folder (standalone git).
# In the monorepo, a root .env is also loaded (this file wins if both set a key).
#
#   cp .env.example .env
#   python -m voice_enable_mcp.server

# --- Bind ---
VOICE_MCP_HOST=127.0.0.1
VOICE_MCP_PORT=8002
VOICE_MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8002

# --- Prompts (defaults to ./prompts) ---
# VOICE_PROMPTS_DIR=./prompts

# --- Speech-to-text (used when audio is passed to this MCP) ---
SPEECH_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
OPENAI_WHISPER_MODEL=whisper-1
# SPEECH_PROVIDER=openai
# OPENAI_API_KEY=
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper

# --- Contract agent LLM (LangGraph voice HITL) ---
# AGENT_MODEL_ID=openai:gpt-5-mini
MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# --- Local metadata ---
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
AUDIO_SUBDIRECTORY=audio
MAX_UPLOAD_MB=25

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
