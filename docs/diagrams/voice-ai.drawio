  <diagram id="voice-langgraph" name="Voice LangGraph HITL">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s" value="START" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="20" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="parse" value="parse_intent&#10;create-contract? entity + ref" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ent" value="fetch_legal_entity&#10;SQLite legal_entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="price" value="fetch_pricelist&#10;fuzzy CR 1001 = CR-1001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hitl" value="await_confirmation&#10;interrupt() HITL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="user" value="User: yes / CR-1001&#10;same thread_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="445" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gen" value="generate_contract&#10;dummy .txt + .docx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="400" y="560" width="200" height="60" as="geometry" />
        </mxCell>
