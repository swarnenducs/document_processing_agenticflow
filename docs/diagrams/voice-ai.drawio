          <mxGeometry x="420" y="670" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rej" value="END rejected&#10;Please ask a relevant service." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="endArrow=classic;html=1;" edge="1" parent="1" source="s" target="parse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" value="ok" style="endArrow=classic;html=1;" edge="1" parent="1" source="parse" target="ent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" value="ok" style="endArrow=classic;html=1;" edge="1" parent="1" source="ent" target="price"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" value="ok" style="endArrow=classic;html=1;" edge="1" parent="1" source="price" target="hitl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" value="paused" style="endArrow=classic;html=1;dashed=1;" edge="1" parent="1" source="hitl" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
