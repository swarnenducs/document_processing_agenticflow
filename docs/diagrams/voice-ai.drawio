  </diagram>
  <diagram id="voice-invoke-sequence" name="API to MAF to Voice MCP">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="TURN 1 — start (typed)" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1. UI → ip_api&#10;POST http://127.0.0.1:8000/api/v1/voice/contract&#10;JSON: transcript, session_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. ip_api invoke_tool('voice', 'start_voice_contract')&#10;POST http://127.0.0.1:8003/invoke&#10;JSON: server=voice, tool=start_voice_contract, arguments={transcript, auto_create}" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. MAF invoke_mcp_tool&#10;HTTP MCP to VOICE_MCP_URL&#10;http://127.0.0.1:8002/mcp  tool start_voice_contract" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Voice MCP start_voice_contract&#10;→ start_voice_contract_agent → LangGraph&#10;parse_intent → fetch_legal_entity → fetch_pricelist → interrupt()" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Response back MCP → MAF → ip_api → UI&#10;status=needs_confirmation + thread_id" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="TURN 2 — confirm" style="text;html=1;fontStyle=1;fontSize=16;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="6. UI → ip_api&#10;POST /api/v1/voice/contract/confirm&#10;JSON: legal_entity, contract_reference_number, thread_id, user_text=yes" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="7. ip_api → MAF POST /invoke&#10;server=voice tool=confirm_voice_contract" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="8. MAF → Voice MCP confirm_voice_contract&#10;resume LangGraph on same thread_id → generate_contract&#10;save_voice_contract then return completed + file paths" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="note" value="NOT this path: POST /api/ask (MAF chat). Voice is jobs-only via /invoke." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
