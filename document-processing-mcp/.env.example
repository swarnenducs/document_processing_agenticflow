# document-processing-mcp — copy to .env in this folder (standalone git).
# In the monorepo, a root .env is also loaded (this file wins if both set a key).
#
#   cp .env.example .env
#   python -m document_processing_mcp.server

# --- Bind ---
DOCUMENT_MCP_HOST=127.0.0.1
DOCUMENT_MCP_PORT=8001
DOCUMENT_MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=8001

# --- Prompts (defaults to ./prompts next to this folder) ---
# DOCUMENT_PROMPTS_DIR=./prompts

# --- LLM #1 mapper / LLM #2 validator ---
MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
MAPPER_MODEL=gpt-5-mini
VALIDATOR_MODEL_ID=openai:gpt-4.1-mini
VALIDATOR_PROVIDER=openai
VALIDATOR_MODEL=gpt-4.1-mini
VALIDATOR_MAX_TOKENS=1024

OPENAI_API_KEY=
# OPENAI_BASE_URL=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# AZURE_OPENAI_VALIDATOR_DEPLOYMENT=gpt-4.1-mini
# GROQ_API_KEY=

# --- Local scratch ---
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
MAX_UPLOAD_MB=25

# --- Azure SQL (job + accuracy tables) ---
# AZURE_SQL_SERVER=YOUR_SQL.database.windows.net
# AZURE_SQL_USER=adminsql
# AZURE_SQL_PASSWORD=
# AZURE_SQL_DATABASE=ipp-app-db
# AZURE_SQL_DIALECT=pyodbc
# AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQLALCHEMY_DATABASE_URL=

# --- Azure Blob (template / JSON / generated .docx) ---
# FILE_STORAGE_BACKEND=azure_blob
# AZURE_BLOB_CONTAINER=docuploadsolution
# AZURE_BLOB_PREFIX=jobs
# Account key / connection string AND SAS can all be set; SAS is used when present.
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_SAS_TOKEN=
# AZURE_STORAGE_SAS_URL=

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000
