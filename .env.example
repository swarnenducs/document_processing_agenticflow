# =============================================================================
# MONOREPO ROOT .env — used by: python run_all_components.py
# =============================================================================
# Copy once at the repo root:
#   cp .env.example .env
#
# Each folder also has its own .env.example for a split git / standalone run:
#   UI/.env.example
#   ip_api/.env.example
#   document-processing-mcp/.env.example
#   voice_enable_mcp/.env.example
#   central-agentic-flow/.env.example
# Component .env is loaded first; this root file fills keys the folder file
# does not set.
#
# Storage (all SQL-using processes):
#   Local  → SQLite  (leave AZURE_SQL_* unset, FILE_STORAGE_BACKEND=local)
#   Cloud  → Azure SQL + Azure Blob (set the Azure blocks below)
# Voice HITL checkpoints default to that same SQL. Optional Redis swap is
# under section 5 (voice_enable_mcp).
# =============================================================================


# =============================================================================
# 0. SHARED — provider keys (mapper, validator, MAF, speech)
# =============================================================================
# Prefer MODEL_ID = provider:model (openai, groq, azure_openai, …).
# Same as: init_chat_model("openai:gpt-5-mini", temperature=0)

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VALIDATOR_DEPLOYMENT=gpt-4.1-mini

GROQ_API_KEY=
# GROQ_VALIDATOR_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=
# GROQ_BASE_URL=

# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=

# OpenAI-compatible (Ollama, vLLM, Together, …)
# MAPPER_MODEL_ID=openai_compatible:llama3.1
# COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_KEY=EMPTY
# OLLAMA_BASE_URL=http://127.0.0.1:11434


# =============================================================================
# 1. SHARED STORAGE — SQLite (local)  |  Azure SQL + Blob (cloud)
# Used by: ip_api, document-processing-mcp, voice_enable_mcp, central-agentic-flow
# Not used by: UI (HTTP client only)
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
TEMPLATES_SUBDIRECTORY=templates
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=25
FILE_STORAGE_BACKEND=local

# --- Cloud: Azure SQL (unset = SQLite above) ---
# AZURE_SQL_SERVER=YOUR_SQL.database.windows.net
# AZURE_SQL_USER=adminsql
# AZURE_SQL_PASSWORD=
# AZURE_SQL_DATABASE=ipp-app-db
# AZURE_SQL_DIALECT=pyodbc
# AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQLALCHEMY_DATABASE_URL=

# --- Cloud: Azure Blob (template / JSON / generated .docx) ---
# FILE_STORAGE_BACKEND=azure_blob
# AZURE_BLOB_CONTAINER=docuploadsolution
# AZURE_BLOB_PREFIX=jobs
# AZURE_BLOB_TEMPLATE_PREFIX=templates
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_STORAGE_SAS_TOKEN=
# AZURE_STORAGE_SAS_URL=

TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000


# =============================================================================
# 2. UI (:7860) — Gradio. No LLM keys, no SQL, no Blob. Talks to ip_api only.
# Standalone file: UI/.env.example
# =============================================================================
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
API_BASE_URL=http://127.0.0.1:8000


# =============================================================================
# 3. ip_api (:8000) — FastAPI gateway, jobs, admin templates, speech, proxies
# Standalone file: ip_api/.env.example
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# API_BASE_URL is in section 2 (UI uses it too)
ADMIN_API_KEY=
MAF_BASE_URL=http://127.0.0.1:8003
# MAF_PROXY_TIMEOUT=320
DOCUMENT_MCP_URL=http://127.0.0.1:8001/mcp
VOICE_MCP_URL=http://127.0.0.1:8002/mcp
SPEECH_PROVIDER=groq
OPENAI_WHISPER_MODEL=whisper-1
GROQ_WHISPER_MODEL=whisper-large-v3
# SPEECH_PROVIDER=openai
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper


# =============================================================================
# 4. document-processing-mcp (:8001) — Word pipeline (mapper + two critics)
# Standalone file: document-processing-mcp/.env.example
# =============================================================================
DOCUMENT_MCP_HOST=127.0.0.1
DOCUMENT_MCP_PORT=8001
DOCUMENT_MCP_TRANSPORT=http
MCP_TRANSPORT=http
# DOCUMENT_PROMPTS_DIR=./document-processing-mcp/prompts

MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
MAPPER_MODEL=gpt-5-mini
# MAPPER_API_KEY=
# MAPPER_BASE_URL=
# MAPPER_API_VERSION=
# MAPPER_TEMPERATURE=0
# MAPPER_MAX_TOKENS=4096

VALIDATOR_MODEL_ID=openai:gpt-4.1-mini
VALIDATOR_PROVIDER=openai
VALIDATOR_MODEL=gpt-4.1-mini
VALIDATOR_MAX_TOKENS=1024
# LLM_MAX_TOKENS=2048

# AGENT_MODEL_ID=openai:gpt-4o
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5
# AGENT_MAX_TOKENS=2048


# =============================================================================
# 5. voice_enable_mcp (:8002) — voice → contract HITL LangGraph
# Standalone file: voice_enable_mcp/.env.example
# =============================================================================
VOICE_MCP_HOST=127.0.0.1
VOICE_MCP_PORT=8002
VOICE_MCP_TRANSPORT=http
# VOICE_PROMPTS_DIR=./voice_enable_mcp/prompts

# HITL checkpointer: sql = SQLite / Azure SQL (section 1). redis = REDIS_URL.
LANGGRAPH_CHECKPOINT_BACKEND=sql
# LANGGRAPH_CHECKPOINT_BACKEND=redis
# REDIS_URL=redis://127.0.0.1:6379/0
# LANGGRAPH_CHECKPOINT_REDIS_PREFIX=lg
# LANGGRAPH_CHECKPOINT_REDIS_TTL_SECONDS=86400


# =============================================================================
# 6. central-agentic-flow MAF (:8003) — chat orchestrator; jobs via POST /invoke
# Standalone file: central-agentic-flow/.env.example
# =============================================================================
MAF_HOST=0.0.0.0
MAF_PORT=8003
# MAF_MCP_TIMEOUT_SECONDS=300
MAF_MODEL_ID=openai:gpt-5-mini
MAF_PROVIDER=openai
MAF_MODEL=gpt-5-mini
# MAF_API_KEY=
# MAF_LLM_BASE_URL=
# MAF_API_VERSION=2024-12-01-preview
# MAF_INSTRUCTIONS=
# MAF_PROMPTS_DIR=./central-agentic-flow/prompts
# MAF_MCP_REGISTRY_FILE=./central-agentic-flow/config/mcp_registry.yml

# Chat-only business MCP (/ask + Foundry). Document and voice stay jobs-only.
# BUSINESS_MCP_URL=http://127.0.0.1:8005/mcp
# MAF_EXTRA_MCPS=fabric=http://127.0.0.1:8004/mcp
# MAF_MCP_FABRIC_DESCRIPTION=Fabric SQL agent
# FABRIC_SQL_AGENT_URL=http://127.0.0.1:8004/mcp
# MAF_MCP_SERVERS=[{"name":"fabric-sql-agent","url":"http://127.0.0.1:8004/mcp","prefix":"fabric","description":"Fabric SQL agent"}]
