# =============================================================================
# LLM ROLES — each role can use a different provider
# Providers: openai | azure_openai (alias: azure) | groq | openai_compatible
# Inject custom providers in code via register_llm_provider(...)
# =============================================================================

# --- LLM #1 — MAPPER (JSON → placeholders / table fills) ---
# Compact form (uses LangChain init_chat_model under the hood):
# MAPPER_MODEL_ID=azure_openai:gpt-5-mini
# Or split vars:
# Use azure_openai and set MAPPER_MODEL to your Azure deployment name
MAPPER_PROVIDER=azure_openai
MAPPER_MODEL=gpt-4o
# MAPPER_API_KEY=                 # optional; falls back to AZURE_OPENAI_API_KEY
# MAPPER_BASE_URL=                # optional; falls back to AZURE_OPENAI_ENDPOINT
# MAPPER_API_VERSION=             # optional; falls back to AZURE_OPENAI_API_VERSION
# MAPPER_TEMPERATURE=0

# --- LLM #2 — VALIDATOR / CRITIC ---
# VALIDATOR_MODEL_ID=groq:openai/gpt-oss-120b
VALIDATOR_PROVIDER=groq
VALIDATOR_MODEL=openai/gpt-oss-120b
# To use Azure for validator too:
# VALIDATOR_PROVIDER=azure_openai
# VALIDATOR_MODEL=gpt-4o

# --- Optional agent orchestrator (defaults to mapper provider) ---
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5

# =============================================================================
# Provider credentials (shared fallbacks)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=
# OPENAI_VALIDATOR_MODEL=gpt-5

# Azure OpenAI / Azure AI Foundry
# Classic: https://YOUR_RESOURCE.openai.azure.com/
# Foundry v1: https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_VALIDATOR_DEPLOYMENT=

# Groq
GROQ_API_KEY=
GROQ_VALIDATOR_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=
# GROQ_BASE_URL=

# OpenAI-compatible (Ollama, vLLM, Together, …) — set MAPPER_PROVIDER=openai_compatible
# COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_KEY=EMPTY

# =============================================================================
# STORAGE — SQLite metadata + filesystem blobs (configurable paths)
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=25

# Mapper / validator / extraction-critic prompt YAML directory (edit without code deploy)
# Files: mapper.yml, validator.yml, extraction_validator.yml
PROMPTS_DIR=./prompts

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# GRADIO UI
# =============================================================================
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# =============================================================================
# SPEECH-TO-TEXT — voice → natural language text (Groq Whisper by default)
# =============================================================================
SPEECH_PROVIDER=groq
OPENAI_WHISPER_MODEL=whisper-1
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional alternatives:
# SPEECH_PROVIDER=openai
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper


#Please create contract with Legal entity AVC with contract reference number CR-1001
