# =============================================================================
# LLM #1 — MAPPER (OpenAI)
# Maps JSON fields → Word template placeholders with per-field confidence
# =============================================================================
OPENAI_API_KEY=
MAPPER_PROVIDER=openai
OPENAI_MODEL=gpt-5

# =============================================================================
# LLM #2 — VALIDATOR / CRITIC (Groq recommended — separate provider from mapper)
# Independently checks template vs generated doc vs JSON
# =============================================================================
VALIDATOR_PROVIDER=groq
GROQ_API_KEY=
GROQ_VALIDATOR_MODEL=openai/gpt-oss-120b

# Fallback validator on OpenAI if Groq is unavailable (set VALIDATOR_PROVIDER=openai)
OPENAI_VALIDATOR_MODEL=gpt-5

# =============================================================================
# STORAGE — SQLite metadata + filesystem blobs (configurable paths)
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=25

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# GRADIO UI
# =============================================================================
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# =============================================================================
# SPEECH-TO-TEXT — voice → natural language text
# =============================================================================
SPEECH_PROVIDER=openai
OPENAI_WHISPER_MODEL=whisper-1
GROQ_WHISPER_MODEL=whisper-large-v3
