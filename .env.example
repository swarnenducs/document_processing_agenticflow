# =============================================================================
# MONOREPO ROOT — used when you run python run_all_components.py from here.
# Each component also has its own .env.example for a future split git:
#   document-processing-mcp/.env.example
#   voice_enable_mcp/.env.example
#   central-agentic-flow/.env.example
#   ip_api/.env.example
#   UI/.env.example
# Copy that file to .env inside the folder; it is loaded first. This root .env
# fills any keys the component file does not set.
# =============================================================================

# Prefer MODEL_ID = provider:model (works for openai, groq, azure_openai,
# anthropic, google_genai, mistralai, … — no provider-specific factory code).
#
# Examples:
#   MAPPER_MODEL_ID=openai:gpt-5-mini
#   VALIDATOR_MODEL_ID=openai:gpt-4.1-mini
# Same as: init_chat_model("openai:gpt-5-mini", temperature=0)
#   MAPPER_MODEL_ID=openai:gpt-4o
#   MAPPER_MODEL_ID=anthropic:claude-sonnet-4-20250514
#   MAPPER_MODEL_ID=google_genai:gemini-2.0-flash
#   VALIDATOR_MODEL_ID=groq:openai/gpt-oss-120b
#
# Runtime (LangGraph):
#   config={"configurable":{"mapper_model_id":"openai:gpt-4o-mini"}}
# Custom SDK: register_llm_provider("my_vendor", builder_fn)
# =============================================================================

# --- LLM #1 — MAPPER ---
MAPPER_MODEL_ID=openai:gpt-5-mini
MAPPER_PROVIDER=openai
MAPPER_MODEL=gpt-5-mini
# MAPPER_API_KEY=                 # optional; falls back to provider credential envs
# MAPPER_BASE_URL=                # optional; falls back to AZURE_OPENAI_ENDPOINT / …
# MAPPER_API_VERSION=
# MAPPER_TEMPERATURE=0
# MAPPER_MAX_TOKENS=4096

# --- LLM #2 — VALIDATOR / CRITIC (LLM-as-judge) ---
VALIDATOR_MODEL_ID=openai:gpt-4.1-mini
VALIDATOR_PROVIDER=openai
VALIDATOR_MODEL=gpt-4.1-mini
# Completion cap (validator defaults to 1024 if unset — avoids TPM 413 on small quotas)
VALIDATOR_MAX_TOKENS=1024
# LLM_MAX_TOKENS=2048            # optional global fallback for all roles

# --- Optional agent orchestrator ---
# AGENT_MODEL_ID=openai:gpt-4o
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5
# AGENT_MAX_TOKENS=2048

# =============================================================================
# MAF (Microsoft Agent Framework) — standalone orchestrator service (:8003)
# run_all_components.py starts this; API proxies POST /api/ask → MAF_BASE_URL
# =============================================================================
MAF_HOST=0.0.0.0
MAF_PORT=8003
MAF_BASE_URL=http://127.0.0.1:8003
# MAF_BASE_URL=http://127.0.0.1:8003   # ip_api talks to MAF over HTTP only
MAF_MODEL_ID=openai:gpt-5-mini
MAF_PROVIDER=openai
MAF_MODEL=gpt-5-mini
# MAF_API_KEY=                 # optional; falls back to OPENAI_/AZURE_/GROQ_ keys
# MAF_LLM_BASE_URL=            # optional LLM endpoint override (OpenAI-compatible / Azure)
# MAF_API_VERSION=2024-12-01-preview
# MAF_MCP_TIMEOUT_SECONDS=300
# MAF_INSTRUCTIONS=            # optional system prompt override
# MAF_PROXY_TIMEOUT=320

# Anthropic / Google / etc. (when using those MODEL_IDs)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=

# =============================================================================
# Provider credentials (shared fallbacks for init_chat_model)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=
# OPENAI_VALIDATOR_MODEL=gpt-5

# Azure OpenAI / Azure AI Foundry
# Classic: https://YOUR_RESOURCE.openai.azure.com/
# Foundry v1: https://YOUR_RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_VALIDATOR_DEPLOYMENT=gpt-4.1-mini

# Groq
GROQ_API_KEY=
GROQ_VALIDATOR_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=
# GROQ_BASE_URL=

# OpenAI-compatible (Ollama, vLLM, Together, …)
# MAPPER_MODEL_ID=openai_compatible:llama3.1
# COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_KEY=EMPTY
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# =============================================================================
# STORAGE — SQLAlchemy metadata + files (local disk or Azure Blob)
# Default local: SQLite + filesystem. For Azure document processing, set SQL + Blob.
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=25

# --- Azure SQL (SQLAlchemy + ODBC Driver 18) ---
AZURE_SQL_SERVER=ipp-sql-serv.database.windows.net
AZURE_SQL_USER=adminsql
AZURE_SQL_PASSWORD=
AZURE_SQL_DATABASE=ipp-app-db
AZURE_SQL_DIALECT=pyodbc
AZURE_SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Optional full URL override:
# SQLALCHEMY_DATABASE_URL=mssql+pyodbc:///?odbc_connect=...

# --- Azure Blob — template, JSON, and generated .docx ---
# FILE_STORAGE_BACKEND is auto azure_blob when a connection string/key is set.
FILE_STORAGE_BACKEND=azure_blob
AZURE_BLOB_CONTAINER=docuploadsolution
AZURE_BLOB_PREFIX=jobs
# Same container, segregated folders:
#   {prefix}/{job_id}/upload/   template.docx + data.json
#   {prefix}/{job_id}/download/ generated .docx
# You can set account key (or connection string) AND SAS together.
# Runtime uses SAS when SAS_URL or SAS_TOKEN is set; otherwise key / connection string.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_SAS_TOKEN=sv=2024-11-04&ss=b&srt=sco&sp=rwdlacupiytfx&se=...&sig=...
AZURE_STORAGE_SAS_URL=https://YOUR_ACCOUNT.blob.core.windows.net/docuploadsolution?sv=...&sig=...

# Mapper / validator / extraction-critic prompts live PER COMPONENT (no shared prompts repo):
#   document-processing-mcp/prompts/   (mapper.yml, validator.yml, extraction_validator.yml)
#   voice_enable_mcp/prompts/
#   central-agentic-flow/prompts/
# DOCUMENT_PROMPTS_DIR=./document-processing-mcp/prompts
# VOICE_PROMPTS_DIR=./voice_enable_mcp/prompts
# MAF_PROMPTS_DIR=./central-agentic-flow/prompts
# PROMPTS_DIR=./prompts   # legacy root; prefer component-specific dirs above

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# GRADIO UI
# =============================================================================
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# =============================================================================
# SEPARATE FASTMCP SERVERS — document_process_mcp + voice_process_mcp
# run_both.py launches both with --transport http by default
# =============================================================================
MCP_TRANSPORT=http
DOCUMENT_MCP_HOST=127.0.0.1
DOCUMENT_MCP_PORT=8001
DOCUMENT_MCP_TRANSPORT=http
DOCUMENT_MCP_URL=http://127.0.0.1:8001/mcp
VOICE_MCP_HOST=127.0.0.1
VOICE_MCP_PORT=8002
VOICE_MCP_TRANSPORT=http
VOICE_MCP_URL=http://127.0.0.1:8002/mcp
# Chat-only business MCP (/ask + Foundry agent). Document and voice are jobs-only.
# BUSINESS_MCP_URL=http://127.0.0.1:8005/mcp
# MCP registry (YAML is the source of truth):
# central-agentic-flow/config/mcp_registry.yml
# MAF_MCP_REGISTRY_FILE=/absolute/path/to/mcp_registry.yml
# One-off extras without editing YAML:
# MAF_EXTRA_MCPS=fabric=http://127.0.0.1:8004/mcp
# MAF_MCP_FABRIC_DESCRIPTION=Fabric SQL agent
# FABRIC_SQL_AGENT_URL=http://127.0.0.1:8004/mcp
# Or JSON:
# MAF_MCP_SERVERS=[{"name":"fabric-sql-agent","url":"http://127.0.0.1:8004/mcp","prefix":"fabric","description":"Fabric SQL agent"}]

# =============================================================================
# REQUEST TRACE / xid — correlate HTTP + tools + LLM responses in SQLite
# =============================================================================
TRACE_LOGGING_ENABLED=true
TRACE_LOG_MAX_CHARS=16000

# =============================================================================
# SPEECH-TO-TEXT — voice → natural language text (Groq Whisper by default)
# =============================================================================
SPEECH_PROVIDER=groq
OPENAI_WHISPER_MODEL=whisper-1
GROQ_WHISPER_MODEL=whisper-large-v3
# Optional alternatives:
# SPEECH_PROVIDER=openai
# SPEECH_PROVIDER=azure_openai
# AZURE_OPENAI_WHISPER_DEPLOYMENT=whisper
