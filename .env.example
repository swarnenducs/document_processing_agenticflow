# =============================================================================
# LLM ROLES — each role can use a different provider
# Providers: openai | azure_openai (alias: azure) | groq | openai_compatible
# Inject custom providers in code via register_llm_provider(...)
# =============================================================================

# --- LLM #1 — MAPPER (JSON → placeholders / table fills) ---
MAPPER_PROVIDER=openai
MAPPER_MODEL=gpt-5
# MAPPER_API_KEY=                 # optional; falls back to provider default key
# MAPPER_BASE_URL=                # optional OpenAI-compatible / override
# MAPPER_API_VERSION=             # Azure only (optional)
# MAPPER_TEMPERATURE=0

# --- LLM #2 — VALIDATOR / CRITIC ---
VALIDATOR_PROVIDER=groq
VALIDATOR_MODEL=openai/gpt-oss-120b
# VALIDATOR_API_KEY=
# VALIDATOR_BASE_URL=
# VALIDATOR_API_VERSION=
# VALIDATOR_TEMPERATURE=0

# --- Optional agent orchestrator (defaults to mapper provider) ---
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5

# =============================================================================
# Provider credentials (shared fallbacks)
# =============================================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=
# OPENAI_VALIDATOR_MODEL=gpt-5

# Azure OpenAI (set MAPPER_PROVIDER=azure_openai or VALIDATOR_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_VALIDATOR_DEPLOYMENT=

# Groq
GROQ_API_KEY=
GROQ_VALIDATOR_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=
# GROQ_BASE_URL=

# OpenAI-compatible (Ollama, vLLM, Together, …) — set MAPPER_PROVIDER=openai_compatible
# COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# COMPATIBLE_API_KEY=EMPTY

# =============================================================================
# STORAGE — SQLite metadata + filesystem blobs (configurable paths)
# =============================================================================
STORAGE_BASE_PATH=./data/storage
SQLITE_DATABASE_PATH=./data/app.db
JOBS_SUBDIRECTORY=jobs
AUDIO_SUBDIRECTORY=audio
JOB_TTL_HOURS=24
MAX_UPLOAD_MB=25

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# =============================================================================
# GRADIO UI
# =============================================================================
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860

# =============================================================================
# SPEECH-TO-TEXT — voice → natural language text
# =============================================================================
SPEECH_PROVIDER=openai
OPENAI_WHISPER_MODEL=whisper-1
GROQ_WHISPER_MODEL=whisper-large-v3
