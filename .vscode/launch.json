{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: API (ipp_agentic_api :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["ip_api.api.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/document-processing-mcp/src${pathSeparator}${workspaceFolder}/voice_enable_mcp/src${pathSeparator}${workspaceFolder}/central-agentic-flow/src${pathSeparator}${workspaceFolder}/ipp_agentic_api/src${pathSeparator}${workspaceFolder}/UI/src${pathSeparator}${workspaceFolder}"
      }
    },
    {
      "name": "Debug: Document MCP (:8001)",
      "type": "debugpy",
      "request": "launch",
      "module": "document_processing_mcp.server",
      "args": ["--transport", "http", "--host", "127.0.0.1", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/document-processing-mcp/src${pathSeparator}${workspaceFolder}${pathSeparator}${workspaceFolder}/ipp_agentic_api/src"
      }
    },
    {
      "name": "Debug: Voice MCP (:8002)",
      "type": "debugpy",
      "request": "launch",
      "module": "voice_enable_mcp.server",
      "args": ["--transport", "http", "--host", "127.0.0.1", "--port", "8002"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/voice_enable_mcp/src${pathSeparator}${workspaceFolder}"
      }
    },
    {
      "name": "Debug: MAF (:8003)",
      "type": "debugpy",
      "request": "launch",
      "module": "central_agentic_flow.server",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/central-agentic-flow/src${pathSeparator}${workspaceFolder}"
      }
    },
    {
      "name": "Debug: UI Gradio (:7860)",
      "type": "debugpy",
      "request": "launch",
      "module": "ui_app.ui.gradio_app",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/UI/src${pathSeparator}${workspaceFolder}"
      }
    }
  ],
  "compounds": [
    {
      "name": "Debug: all services",
      "configurations": [
        "Debug: Document MCP (:8001)",
        "Debug: Voice MCP (:8002)",
        "Debug: MAF (:8003)",
        "Debug: API (ipp_agentic_api :8000)",
        "Debug: UI Gradio (:7860)"
      ],
      "stopAll": true
    }
  ]
}
